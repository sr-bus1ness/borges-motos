rules_version = '2';
// Só a conta da oficina pode ler e gravar.
// Troque o e-mail abaixo se usar outro (tem que ser o mesmo de js/config.js).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == 'borgesmotos3800@gmail.com';
    }
  }
}
